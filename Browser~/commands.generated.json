{
  "schema_version": 1,
  "default_scenario_id": "",
  "scenarios": [
    {
      "id": "initialize",
      "label": "Initialize viewer",
      "command": "initialize_viewer",
      "payload": { "revision": "$revision" },
      "run_automatically": true,
      "expected_success": true
    },
    {
      "id": "select-red",
      "label": "Select red",
      "command": "select_elements",
      "payload": { "revision": "$revision", "element_ids": ["red"] },
      "run_automatically": true,
      "expected_success": true
    },
    {
      "id": "select-green-blue",
      "label": "Select green and blue",
      "command": "select_elements",
      "payload": {
        "revision": "$revision",
        "element_ids": ["green", "blue"]
      },
      "run_automatically": true,
      "expected_success": true
    },
    {
      "id": "clear-selection",
      "label": "Clear selection",
      "command": "clear_selection",
      "payload": { "revision": "$revision" },
      "run_automatically": true,
      "expected_success": true
    },
    {
      "id": "invalid-selection",
      "label": "Reject unknown element",
      "command": "select_elements",
      "payload": { "revision": "$revision", "element_ids": ["missing"] },
      "run_automatically": true,
      "expected_success": false
    },
    {
      "id": "stale-selection",
      "label": "Reject stale revision",
      "command": "select_elements",
      "payload": { "revision": "$stale_revision", "element_ids": ["blue"] },
      "run_automatically": true,
      "expected_success": false
    },
    {
      "id": "dispose",
      "label": "Dispose viewer",
      "command": "dispose_viewer",
      "payload": { "revision": "$revision" },
      "run_automatically": true,
      "expected_success": true
    },
    {
      "id": "update-access-token",
      "label": "Update access token (safe invalid example)",
      "command": "update_access_token",
      "payload": { "access_token": "" },
      "run_automatically": false,
      "expected_success": false
    },
    {
      "id": "update-access-token-legacy",
      "label": "Update access token compatibility alias",
      "command": "updateaccesstoken",
      "payload": { "access_token": "" },
      "run_automatically": false,
      "expected_success": false
    },
    {
      "id": "refresh-access-token",
      "label": "Refresh access token",
      "command": "refresh_access_token",
      "payload": {},
      "run_automatically": false,
      "expected_success": true
    },
    {
      "id": "clear-access-token",
      "label": "Clear access token",
      "command": "clear_access_token",
      "payload": {},
      "run_automatically": false,
      "expected_success": true
    }
  ]
}
